# Site
NEXT_PUBLIC_SITE_URL=https://septicpumpingquote.com

# Local admin fallback (used when Firebase is not configured)
ADMIN_DEV_PASSWORD=change-me-local-admin

# Firebase client (admin auth + optional client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side Firestore + token verify)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Prefer BASE64 on Vercel (avoids newline paste issues). Encode the full PEM including BEGIN/END lines.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
# Or from the JSON private_key string after writing it to a .pem file.
FIREBASE_PRIVATE_KEY_BASE64=
# Alternative (local): one-line PEM with \n escapes
FIREBASE_PRIVATE_KEY=
# Firestore DB id. Default is (default). If console created "default", set that instead.
FIRESTORE_DATABASE_ID=(default)

# Google Analytics 4 / GTM
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Google Search Console API (service account)
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_PROPERTY=sc-domain:septicpumpingquote.com

# Optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
